# Build artifacts. build*/ covers every tree the README documents --
# build-debug, build-profile, build-kprof -- not just the default one.
build*/
navsolver
navsolver_tests
navsolver_omp
navsolver_cuda
navsolver.log
reference/navsto
*.o
*.d
scripts/roofline/peak_flops
scripts/roofline/peak_flops_omp
scripts/roofline/peak_bandwidth
scripts/roofline/peak_bandwidth_omp
scripts/roofline/peak_exp_throughput
scripts/roofline/peak_exp_throughput_omp

# Experiment output (regenerated by running the solver). Both paths hold the
# same kind of thing -- VTK snapshots and convergence CSVs, hundreds of MB for
# a production grid. results/ is the pre-experiments/ location, kept ignored so
# an old config pointing there cannot commit its output.
experiments/results/*
!experiments/results/.gitkeep
results/

# Python / notebooks
.venv/
__pycache__/
.ipynb_checkpoints/

# Editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
